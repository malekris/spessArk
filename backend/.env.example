# Copy this file to .env for local development. Never commit real credentials.

# Server and authentication
PORT=5001
HOST=127.0.0.1
VINE_PUBLIC_BASE_URL=http://localhost:5173
# Generate a unique value, for example with: openssl rand -hex 32
JWT_SECRET=
# Required: no fallback credentials are accepted. Use a password with at least
# 12 characters; JWT_SECRET should remain machine-generated and much longer.
BOARDING_ADMIN_USERNAME=
BOARDING_ADMIN_PASSWORD=
# Required only to provision an empty database; remove after the first admin is created.
ADMIN_USERNAME=
ADMIN_PASSWORD=
VINE_JWT_EXPIRES_IN=7d

# Database
# Set MYSQL_URL, or leave it empty and configure the DB_* values below.
MYSQL_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Transactional email
RESEND_API_KEY=
EMAIL_VERIFICATION=false

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 public media storage
USE_R2_UPLOADS=false
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Optional Vine integrations
GIPHY_API_KEY=
NEWS_RSS_FEEDS=
VINE_NEWS_BOT_USERNAME=vine_news

# VITE_* variables belong in the frontend environment and are public in the
# built client. Never place credentials or secrets in them.
